virglrenderer/amdgpu: per-guest VRAM budget

Applies against virglrenderer 123e0bc.

A guest on the DRM native-context path sizes itself to the card it is told it
has. Told the whole card, a guest sharing it with others sizes its texture pools
as if it were alone, and the card overcommits: the kernel then puts some guest's
buffers in system memory, its work runs several times slower, and on a graphics
engine every guest shares, every guest slows down with it.

This adds a per-guest budget from NESTRI_VRAM_LIMIT_MIB, and makes every path
that tells the guest how big the card is, or how much of it is used, describe a
card of the budget's size that only this guest uses:

  * the shmem heap block, AMDGPU_INFO_MEMORY and AMDGPU_INFO_VRAM_GTT report the
    budget as the card's size;
  * the same, and AMDGPU_INFO_VRAM_USAGE, AMDGPU_INFO_VIS_VRAM_USAGE and
    AMDGPU_INFO_GTT_USAGE, report this guest's own usage. RADV builds
    VK_EXT_memory_budget as heap size - card usage + own usage, so answered for
    the whole card, every other guest's VRAM counted against this one's budget.

The usage is tallied per process, not per context: one VMM process serves one
guest, and a guest opens several contexts (its game, compositor and encoder).

**This patch does not enforce the budget.** That is the kernel's job: the VMM
runs each guest in a cgroup whose dmem.min is its budget, which keeps neighbours
from pushing it out; past it the guest borrows VRAM nobody is using, and the
kernel evicts what it borrowed when a neighbour needs its own share. An earlier version of this patch refused
GEM_NEW past the budget instead, and that is wrong in a way worth recording: the
guest kernel's RESOURCE_CREATE_BLOB ioctl carries the GEM_NEW but does not wait
for it, so Mesa never learns of the refusal, keeps a buffer the host never made,
and every later submit touching it fails. Measured -- a Unity title past its
budget rendered garbage, with thousands of failed submits.

diff --git a/src/drm/amdgpu/amdgpu_renderer.c b/src/drm/amdgpu/amdgpu_renderer.c
index 8f05f1a..0ab2eae 100644
--- a/src/drm/amdgpu/amdgpu_renderer.c
+++ b/src/drm/amdgpu/amdgpu_renderer.c
@@ -136,9 +136,85 @@ struct amdgpu_object {
    bool has_metadata    :1;
    bool exported        :1;
    bool enable_cache_wc :1;
+   /* NESTRI: which of this guest's tallies this object's size is in. */
+   uint8_t nestri_heap  :2;
 };
 DEFINE_CAST(drm_object, amdgpu_object)
 
+/* NESTRI: per-guest VRAM budget, from NESTRI_VRAM_LIMIT_MIB.
+ *
+ * A guest sizes itself to the card it is told it has. Told the whole card, a
+ * guest sharing it with others sizes its texture pools as if it were alone,
+ * and the card overcommits. So a guest given a budget is told the budget is
+ * the card, and told its own usage rather than the card's: the heap sizes, and
+ * the usage queries RADV builds VK_EXT_memory_budget from, all describe a card
+ * of the budget's size that only this guest is using.
+ *
+ * Looking after the budget is the kernel's job, not this file's: the VMM puts
+ * each guest in a cgroup whose dmem.min is the budget, which protects it from
+ * its neighbours; past it the guest borrows VRAM nobody is using, and gives it
+ * back to system memory when a neighbour needs its own. Refusing allocations here was
+ * tried and is wrong: the guest kernel does not wait for GEM_NEW, so a refusal
+ * never reaches Mesa, which uses a buffer the host never made, and every submit
+ * touching it fails.
+ *
+ * One VMM process serves one guest, and every context it opens is that guest's,
+ * so the tallies are the process's and not a context's.
+ */
+enum nestri_heap {
+   NESTRI_HEAP_NONE = 0,
+   NESTRI_HEAP_VRAM,
+   NESTRI_HEAP_GTT,
+};
+
+static uint64_t nestri_vram_limit;
+static uint64_t nestri_held[3];
+
+static void
+nestri_hold(struct amdgpu_object *obj, uint32_t preferred_heap)
+{
+   if (preferred_heap & AMDGPU_GEM_DOMAIN_VRAM)
+      obj->nestri_heap = NESTRI_HEAP_VRAM;
+   else if (preferred_heap & AMDGPU_GEM_DOMAIN_GTT)
+      obj->nestri_heap = NESTRI_HEAP_GTT;
+   else
+      return;
+   __atomic_add_fetch(&nestri_held[obj->nestri_heap], obj->base.size, __ATOMIC_RELAXED);
+}
+
+static void
+nestri_release(struct amdgpu_object *obj)
+{
+   if (obj->nestri_heap != NESTRI_HEAP_NONE)
+      __atomic_sub_fetch(&nestri_held[obj->nestri_heap], obj->base.size, __ATOMIC_RELAXED);
+}
+
+/* What this guest holds in VRAM, as the budget-sized card it is told it has
+ * would report it: never more than the card.
+ */
+static uint64_t
+nestri_vram_used(void)
+{
+   uint64_t used = __atomic_load_n(&nestri_held[NESTRI_HEAP_VRAM], __ATOMIC_RELAXED);
+   return used < nestri_vram_limit ? used : nestri_vram_limit;
+}
+
+static uint64_t
+nestri_gtt_used(void)
+{
+   return __atomic_load_n(&nestri_held[NESTRI_HEAP_GTT], __ATOMIC_RELAXED);
+}
+
+/* A macro rather than a function because the two families of struct that report
+ * VRAM use different 64-bit typedefs -- libdrm's uint64_t and the uapi's __u64 --
+ * which are distinct types to the compiler even where they are the same width.
+ */
+#define NESTRI_CAP(field, cap)                                                   \
+   do {                                                                          \
+      if ((field) > (cap))                                                       \
+         (field) = (cap);                                                        \
+   } while (0)
+
 static void free_id_to_ctx(struct hash_entry *entry)
 {
    amdgpu_cs_ctx_free(entry->data);
@@ -277,6 +353,11 @@ amdgpu_renderer_free_object(struct drm_context *dctx, struct drm_object *dobj)
 
    print(2, "free obj res_id: %d", dobj->res_id);
 
+   /* NESTRI: drm_context_deinit() frees every object a context created, so
+    * this runs whether the guest unreffed the resource or simply died.
+    */
+   nestri_release(obj);
+
    amdgpu_bo_free(obj->bo);
    free(obj);
 }
@@ -366,6 +447,19 @@ update_heap_info_in_shmem(struct amdgpu_context *ctx)
    amdgpu_query_heap_info(ctx->dev, AMDGPU_GEM_DOMAIN_GTT,
                           0,
                           &ctx->shmem->gtt);
+
+   /* NESTRI: the budget as the card, and this guest's usage as its usage. */
+   if (nestri_vram_limit) {
+      NESTRI_CAP(ctx->shmem->vram.heap_size, nestri_vram_limit);
+      NESTRI_CAP(ctx->shmem->vram.max_allocation, nestri_vram_limit);
+      ctx->shmem->vram.heap_usage = nestri_vram_used();
+
+      NESTRI_CAP(ctx->shmem->vis_vram.heap_size, nestri_vram_limit);
+      NESTRI_CAP(ctx->shmem->vis_vram.max_allocation, nestri_vram_limit);
+      ctx->shmem->vis_vram.heap_usage = nestri_vram_used();
+
+      ctx->shmem->gtt.heap_usage = nestri_gtt_used();
+   }
 }
 
 static int
@@ -501,6 +595,55 @@ amdgpu_ccmd_query_info(struct drm_context *dctx, struct vdrm_ccmd_req *hdr)
             "ioctl error: fd: %d request.query: 0x%x r: %d|%d %s",
             amdgpu_device_get_fd(ctx->dev), request.query, rsp->hdr.ret, r, strerror(errno));
 
+   /* NESTRI: every query that tells the guest how big the card is or how much
+    * of it is used answers for the budget-sized card this guest is told it has.
+    * Short reads are the guest's business, but a partial struct must not be
+    * rewritten as though it were whole.
+    */
+   if (r == 0 && nestri_vram_limit) {
+      uint64_t lim = nestri_vram_limit;
+      switch (request.query) {
+      case AMDGPU_INFO_MEMORY:
+         if (return_size >= sizeof(struct drm_amdgpu_memory_info)) {
+            struct drm_amdgpu_memory_info *mi = value;
+            NESTRI_CAP(mi->vram.total_heap_size, lim);
+            NESTRI_CAP(mi->vram.usable_heap_size, lim);
+            NESTRI_CAP(mi->vram.max_allocation, lim);
+            mi->vram.heap_usage = nestri_vram_used();
+
+            NESTRI_CAP(mi->cpu_accessible_vram.total_heap_size, lim);
+            NESTRI_CAP(mi->cpu_accessible_vram.usable_heap_size, lim);
+            NESTRI_CAP(mi->cpu_accessible_vram.max_allocation, lim);
+            mi->cpu_accessible_vram.heap_usage = nestri_vram_used();
+
+            mi->gtt.heap_usage = nestri_gtt_used();
+         }
+         break;
+      case AMDGPU_INFO_VRAM_GTT:
+         if (return_size >= sizeof(struct drm_amdgpu_info_vram_gtt)) {
+            struct drm_amdgpu_info_vram_gtt *vg = value;
+            NESTRI_CAP(vg->vram_size, lim);
+            NESTRI_CAP(vg->vram_cpu_accessible_size, lim);
+         }
+         break;
+      /* RADV's memory budget is the heap size, less the card's usage, plus
+       * its own: answered for the whole card, every other guest's VRAM would
+       * count against this one's budget.
+       */
+      case AMDGPU_INFO_VRAM_USAGE:
+      case AMDGPU_INFO_VIS_VRAM_USAGE:
+         if (return_size >= sizeof(uint64_t))
+            *(uint64_t *)value = nestri_vram_used();
+         break;
+      case AMDGPU_INFO_GTT_USAGE:
+         if (return_size >= sizeof(uint64_t))
+            *(uint64_t *)value = nestri_gtt_used();
+         break;
+      default:
+         break;
+      }
+   }
+
    memcpy(rsp->payload, value, req->info.return_size);
    free(value);
 
@@ -552,6 +695,7 @@ amdgpu_ccmd_gem_new(struct drm_context *dctx, struct vdrm_ccmd_req *hdr)
       goto va_map_failed;
 
    obj->base.handle = gem_handle;
+   nestri_hold(obj, req->r.preferred_heap);
    /* Enable Write-Combine except for GTT buffers with WC disabled. */
    obj->enable_cache_wc =
       (req->r.preferred_heap != AMDGPU_GEM_DOMAIN_GTT) ||
@@ -1244,6 +1388,21 @@ amdgpu_renderer_create(int fd, size_t debug_len, const char *debug_name)
    if (d)
       ctx->debug = atoi(d);
 
+   /* NESTRI: the guest's budget. Every context reads the same value, because
+    * the environment is the process's; absent or 0 means none.
+    */
+   const char *vram_mib = getenv("NESTRI_VRAM_LIMIT_MIB");
+   if (vram_mib) {
+      char *end = NULL;
+      unsigned long long mib = strtoull(vram_mib, &end, 10);
+      if (end && *end == '\0' && mib > 0) {
+         nestri_vram_limit = (uint64_t)mib << 20;
+         print(1, "VRAM budget %llu MiB", mib);
+      } else {
+         print(0, "ignoring malformed NESTRI_VRAM_LIMIT_MIB=\"%s\"", vram_mib);
+      }
+   }
+
    print(1, "amdgpu_renderer_create name=%s fd=%d (from %d) -> dev=%p", ctx->debug_name, fd,
          amdgpu_device_get_fd(ctx->dev), (void*)ctx->dev);
 
