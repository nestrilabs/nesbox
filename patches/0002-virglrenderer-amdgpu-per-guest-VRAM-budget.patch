+/* NESTRI: present the guest's budget as if it were the card's VRAM.
+ *
+ * Refusing an over-budget allocation contains the damage but cannot report it:
+ * the guest kernel's blob-create ioctl succeeds whatever the host did with the
+ * GEM_NEW inside it, so Mesa never sees an allocation fail and the guest hangs
+ * on a fence instead of returning an error. Measured.
+ *
+ * A guest that is told a small heap, on the other hand, refuses its own
+ * allocations through the ordinary Vulkan budget path, with the ordinary error.
+ * So the report is the mechanism that makes a cooperative guest behave, and the
+ * budget check in GEM_NEW is only the backstop for a guest that ignores it.
+ *
+ * Every path that tells the guest how much VRAM exists has to agree, or the
+ * guest fails somewhere other than where it was told it would: the shmem heap
+ * block below, and AMDGPU_INFO_MEMORY and AMDGPU_INFO_VRAM_GTT in
+ * amdgpu_ccmd_query_info().
+ */
+/* A macro rather than a function because the two families of struct that report
+ * VRAM use different 64-bit typedefs -- libdrm's uint64_t and the uapi's __u64 --
+ * which are distinct types to the compiler even where they are the same width.
+ */
+#define NESTRI_CAP(field, cap)                                                   \
+   do {                                                                          \
+      if ((field) > (cap))                                                       \
+         (field) = (cap);                                                        \
+   } while (0)
+
+/* This guest's VRAM window: how much it may hold, and how much it holds now. */
+#define NESTRI_VRAM_WINDOW(ctx, lim, used)                                       \
+   uint64_t lim = (ctx)->vram_limit;                                             \
+   uint64_t used = (ctx)->vram_charged < lim ? (ctx)->vram_charged : lim
+
 static void
 update_heap_info_in_shmem(struct amdgpu_context *ctx)
 {
@@ -366,6 +430,21 @@
    amdgpu_query_heap_info(ctx->dev, AMDGPU_GEM_DOMAIN_GTT,
                           0,
                           &ctx->shmem->gtt);
+
+   if (ctx->vram_limit) {
+      NESTRI_VRAM_WINDOW(ctx, lim, used);
+      /* struct amdgpu_heap_info has no total/usable split. Usage is set to this
+       * guest's own, not the card's: a guest told a heap it has barely touched
+       * is nearly full will degrade itself for no reason.
+       */
+      NESTRI_CAP(ctx->shmem->vram.heap_size, lim);
+      ctx->shmem->vram.heap_usage = used;
+      NESTRI_CAP(ctx->shmem->vram.max_allocation, lim - used);
+
+      NESTRI_CAP(ctx->shmem->vis_vram.heap_size, lim);
+      ctx->shmem->vis_vram.heap_usage = used;
+      NESTRI_CAP(ctx->shmem->vis_vram.max_allocation, lim - used);
+   }
 }
 
